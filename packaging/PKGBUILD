# Maintainer: Juan Vargas <66626747+v4rgas@users.noreply.github.com>

pkgname=photo-triage
pkgver=0.1.0
pkgrel=1
pkgdesc="Search a folder of photos and videos by describing what they show, entirely offline"
arch=('any')
url="https://github.com/v4rgas/photo-triage"
license=('MIT')

# Everything is a real dependency so that pacman owns every file and nothing
# is fetched at runtime. `python-pytorch` is named rather than one of its
# variants because `python-pytorch-rocm` and `python-pytorch-cuda` both provide
# it and conflict with each other, which is how Arch expresses "pick the build
# that matches your hardware": pacman prompts, and whichever you choose
# satisfies this. python-torchvision in the official repositories depends on it
# exactly this way.
depends=(
  'python'
  'python-flask'
  'python-pillow'
  'python-numpy'
  'python-imagehash'
  'python-av'
  'python-pytorch'
  'python-open-clip-torch'
)
optdepends=(
  'python-pytorch-rocm: embedding on an AMD GPU rather than the CPU, ~20x faster'
  'python-pytorch-cuda: embedding on an NVIDIA GPU rather than the CPU, ~20x faster'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
checkdepends=('python-pytest')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('73a6d7a842e0dd88de1b5552aa1d651d13cc4470fef8b407110ffcb41cdc4e5d')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # The suite deliberately does not need PyTorch: only embedding and text
  # search do, and neither is exercised here.
  python -m pytest -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
